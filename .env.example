# Copy this file to .env, then change the values.
# .env is listed in .gitignore, so it is never uploaded to GitHub.

# --- Local development (PostgreSQL on your own laptop) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasktracker

# --- SSL ---
# Local PostgreSQL usually runs without SSL. On Render you need SSL, and it
# turns on automatically when NODE_ENV=production. If NODE_ENV is not set in
# the Render dashboard, add DATABASE_SSL=true there instead.
# Force SSL off with DATABASE_SSL=false (some internal Render URLs need this).
# DATABASE_SSL=true
